{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "api/**/*.ts",
    "schemas/**/*.ts",
    "web/**/*.ts",
    "web/**/*.svelte",
    "playwright.config.ts"
  ]
}

{
  "name": "gigger",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "api",
    "web",
    "schemas"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "build": "bun run --filter @gigger/web build",
    "check": "tsc --noEmit && svelte-check --workspace web --tsconfig ../tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.3.11",
    "svelte-check": "4.4.5",
    "typescript": "5.9.3"
  }
}

# Host port for the local HTTP proxy
PORT=8080

# Set this when using a hostname other than localhost (include scheme and port).
# APP_ORIGIN=http://localhost:8080

# Meta app for the Messenger and Instagram inbox (leave empty to disable).
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_CONFIG_ID=
# Encrypts stored Page and storage tokens; required with META_APP_ID (openssl rand -hex 32).
# TOKEN_KEY=
# Set to 1 once the Meta app holds the Human Agent permission: replies up to 7 days after the contact's last message.
# META_HUMAN_AGENT=

# Host port for the local HTTP proxy
PORT=8080

# Set this when using a hostname other than localhost (include scheme and port).
# APP_ORIGIN=http://localhost:8080

# Meta app for the Messenger and Instagram inbox (leave empty to disable).
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_CONFIG_ID=
# Encrypts stored Page and storage tokens; required with META_APP_ID (openssl rand -hex 32).
# TOKEN_KEY=
# Set to 1 once the Meta app holds the Human Agent permission: replies up to 7 days after the contact's last message.
# META_HUMAN_AGENT=

# Self-hosted LibreTranslate base URL for inbox reading aids (no trailing path).
# LIBRETRANSLATE_URL=
# Optional LibreTranslate API key.
# LIBRETRANSLATE_API_KEY=

# Production (scripts/deploy.sh with compose.prod.yml). Set on the server; leave blank locally.
# Public hostname Caddy serves with automatic HTTPS, and the matching origin.
# DOMAIN=
# APP_ORIGIN=
# Image tag to run: main, pr-N or a commit SHA.
# IMAGE_TAG=main
# GitHub token with read:packages, for pulling the private images on the server.
# GHCR_TOKEN=
